rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // ---------------------------------------------------------------
    // Filiação (NOTA DE PRODUÇÃO):
    // get()/exists() só podem ser usados em leituras de DOC ÚNICO (get)
    // ou em queries cujo caminho é estático por request (path de
    // subcollection ex.: /chats/{campaignId}/messages). Em queries de
    // coleção top-level (list) o caminho do get() variaria por documento
    // ("security rules are not filters") -> a query inteira é negada.
    // Por isso campaignMembers e characters usam field-check em list.
    // ---------------------------------------------------------------
    function isMemberRoles(roles) {
      return roles is map && roles.keys().hasAny([request.auth.uid]);
    }

    function campaignMemberRoles(campaignId) {
      let docData = get(/databases/$(database)/documents/campaignMembers/$(campaignId)).data;
      return 'members' in docData ? docData.members : {};
    }

    function isCampaignMember(campaignId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/campaignMembers/$(campaignId)) &&
        isMemberRoles(campaignMemberRoles(campaignId));
    }

    function isCampaignGM(campaignId) {
      return isCampaignMember(campaignId) &&
        campaignMemberRoles(campaignId).get(request.auth.uid, '') == 'gm';
    }

    function isCampaignOwner(campaignId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/campaigns/$(campaignId)) &&
        get(/databases/$(database)/documents/campaigns/$(campaignId)).data.ownerId == request.auth.uid;
    }

    function isTableOwner(campaignId) {
      return isCampaignGM(campaignId) || isCampaignOwner(campaignId);
    }

    // Perfis: cada usuário só lê/escreve o próprio.
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // Campanhas: metadados legíveis por qualquer logado que tenha o link/id;
    // apenas o dono cria/atualiza/remove. ownerId é imutável e name validado.
    match /campaigns/{campaignId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow update: if isCampaignOwner(campaignId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0;
      allow delete: if isCampaignOwner(campaignId);
    }

    // Filiação: doc único por campanha (members: {uid: 'gm'|'pc'} + memberUids).
    // get usa resource.data/campo; list usa o MESMO campo da query
    // (memberUids) via campo-check, pois get()/exists() quebram queries.
    match /campaignMembers/{campaignId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn()
        && resource.data.get('memberUids', []).hasAny([request.auth.uid]);
      allow create: if isSignedIn()
        && request.resource.data.campaignId == campaignId
        && request.resource.data.members.keys().hasOnly([request.auth.uid])
        && request.resource.data.members.get(request.auth.uid, '') == 'gm'
        && request.resource.data.memberUids.size() == 1
        && request.resource.data.memberUids.hasAll([request.auth.uid]);
      allow update: if isCampaignOwner(campaignId)
        || (isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberUids'])
          && request.resource.data.members.keys().hasAny([request.auth.uid])
          && !resource.data.members.keys().hasAny([request.auth.uid])
          && request.resource.data.members.get(request.auth.uid, '') == 'pc'
          && request.resource.data.memberUids.size() == resource.data.memberUids.size() + 1);
    }

    // Chat da campanha: membros leem; autor cria/edita/remove a própria
    // mensagem; mestre/dono pode moderar. Read via isCampaignMember(campaignId)
    // é válido aqui: campaignId vem do path da subcollection (estático).
    match /chats/{campaignId}/messages/{messageId} {
      allow read: if isCampaignMember(campaignId);
      allow create: if isCampaignMember(campaignId)
        && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isCampaignMember(campaignId)
        && (resource.data.userId == request.auth.uid
          || isTableOwner(campaignId));
    }

    // Anotações: doc único por campanha; membros leem/escrevem registrando
    // autoria em updatedBy; apenas mestre/dono remove.
    match /notes/{campaignId} {
      allow read: if isCampaignMember(campaignId);
      // create: doc completo (setDoc sem merge) — exige campaignId e autoria.
      allow create: if isCampaignMember(campaignId)
        && request.resource.data.campaignId == campaignId
        && request.resource.data.updatedBy == request.auth.uid;
      // update: use diff() (funciona igual no emulador e na produção, onde
      // request.resource pode vir "hidratado" ou só com o delta). Bloqueia
      // mudança de campaignId; autoria obrigatória via get() com default.
      allow update: if isCampaignMember(campaignId)
        && request.resource.data.get('updatedBy', '') == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['campaignId']);
      allow delete: if isTableOwner(campaignId);
    }

// Fichas: SUBCOLEÇÃO de campaigns (campaigns/{campaignId}/characters/...).
    // campaignId vem do path — ESTÁTICO por request → isCampaignMember() é
    // válido em get E list (queries). A prova de filiação funciona no emulador
    // e na produção, ao contrário do modelo top-level (get()/exists() ou
    // request.query.where quebram/queries).
    match /campaigns/{campaignId}/characters/{characterId} {
      allow read: if isCampaignMember(campaignId);
      allow create: if isCampaignMember(campaignId)
        && request.resource.data.campaignId == campaignId
        && request.resource.data.userId == request.auth.uid;
      // update via diff(): idêntico no emulador (delta) e na produção
      // (request.resource "hidratado"); bloqueia troca de dono/campanha.
      allow update: if isCampaignMember(campaignId)
        && (resource.data.userId == request.auth.uid
          || isTableOwner(campaignId))
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['campaignId', 'userId']);
      allow delete: if isCampaignMember(campaignId)
        && (resource.data.userId == request.auth.uid
          || isTableOwner(campaignId));
    }

    // Estado da mesa (combate, mapa, música, NPCs): doc único por campanha;
    // membros leem, somente o mestre/dono altera.
    match /combat/{campaignId} {
      allow read: if isCampaignMember(campaignId);
      allow write: if isTableOwner(campaignId);
    }

    match /map/{campaignId} {
      allow read: if isCampaignMember(campaignId);
      allow write: if isTableOwner(campaignId);
    }

    match /music/{campaignId} {
      allow read: if isCampaignMember(campaignId);
      allow write: if isTableOwner(campaignId);
    }

    match /npcs/{campaignId} {
      allow read: if isCampaignMember(campaignId);
      allow write: if isTableOwner(campaignId);
    }

    // Presença: quem está online na sessão. Cada jogador escreve seu próprio doc.
    match /presence/{campaignId}/users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}