    { "name": "Miserável", "cost": "—", "description": "Você vive em condições desumanas, sem lar e com abrigo incerto, enfrentando violência, doença e fome." },
    { "name": "Esquálido", "cost": "1 PP por dia", "description": "Abrigo precário contra os elementos em um ambiente desesperado, violento e repleto de doença e fome." },
    { "name": "Pobre", "cost": "2 PP por dia", "description": "Comida e alojamento simples, roupas surradas e condições imprevisíveis garantem apenas a subsistência." },
    { "name": "Modesto", "cost": "1 PO por dia", "description": "Condições de vida básicas e simples, sem fome ou sede, vivendo em uma parte mais antiga da cidade." },
    { "name": "Confortável", "cost": "2 PO por dia", "description": "Você pode pagar roupas melhores e manter facilmente o seu equipamento em um pequeno chalé ou estalagem." },
    { "name": "Abastado", "cost": "4 PO por dia", "description": "Vida de luxo com hospedagem respeitável, provavelmente com uma pequena equipe de servos." },
    { "name": "Aristocrático", "cost": "10 PO no mínimo por dia", "description": "Vida de abundância e conforto entre as pessoas mais poderosas da comunidade, com servos atendendo todas as necessidades." }
